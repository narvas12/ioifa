# Copy to .env and fill in real values. Never commit .env.

# Remote REST backend used by the app's service layer
VITE_BASE_URL=https://olif.ng/api/v1

# Cloudinary (training gallery)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_API_KEY=
VITE_CLOUDINARY_API_SECRET=
VITE_CLOUDINARY_FOLDER=

# ---------------------------------------------------------------------------
# Paystack (membership payments) — SERVER-SIDE ONLY.
# Used by the Vercel serverless functions in api/paystack/*.
# Do NOT prefix with VITE_ — that would expose the key in the client bundle.
#
# Local dev:   put your sk_test_... key here and run `npx vercel dev`
#              (plain `npm run dev` does not serve the api/ functions).
# Production:  set PAYSTACK_SECRET_KEY in the Vercel dashboard —
#              sk_test_... for Preview, sk_live_... for Production.
# Also register the webhook URL https://<your-domain>/api/paystack/webhook
# in Paystack Dashboard -> Settings -> API Keys & Webhooks (per mode).
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
